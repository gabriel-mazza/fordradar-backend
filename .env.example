# Copie para .env (NÃO commitar) ou configure como variáveis/secrets do ambiente de deploy.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
SPRING_DATASOURCE_USERNAME=RMxxxxxx
SPRING_DATASOURCE_PASSWORD=troque-me

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (chave AES-256 dos dados pessoais; perdeu a chave = perdeu os dados)
DATA_ENCRYPTION_KEY=
LLM_API_KEY=

# Primeiro administrador (opcional, senha >= 12 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:8081
SERVER_FORWARD_HEADERS=none
SWAGGER_ENABLED=false
